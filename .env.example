SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RFQ_TABLE=rfqs

RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# RFQ management page credentials (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 生产部署常用安全配置
# 多个域名用英文逗号分隔，例如：https://demo.example.com,https://www.demo.example.com
CORS_ORIGINS=

# 默认 true；如需关闭 X-* 安全响应头可设为 0
SECURITY_HEADERS_ENABLED=true

# 本地开发如需测试特定来源可设为 1；生产可保持空
